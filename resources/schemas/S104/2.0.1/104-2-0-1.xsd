	<xs:element name="S100_ExchangeCatalogue" type="S100_ExchangeCatalogue"/>
	
	<xs:complexType name="S100_ExchangeCatalogue">
		<xs:annotation>
			<xs:documentation>Each exchange set has a single S-100_ExchangeCatalogue which contains meta information for the data and support files in the exchange set. </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="identifier" type="S100_ExchangeCatalogueIdentifier" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Uniquely identifies this exchange catalogue</xs:documentation>
					<xs:documentation>Mandatory in this product</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="contact" type="S100_CataloguePointofContact" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Details about the issuer of this exchange catalogue</xs:documentation>
					<xs:documentation>Mandatory in this product</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="productSpecification" type="S100_ProductSpecification" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Details about the product specifications used for the datasets contained in the exchange catalogue. Conditional on all the datasets using the same product specification.</xs:documentation>
					<xs:documentation>Mandatory in this product</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="defaultLocale" type="lan:PT_Locale_PropertyType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Default language and character set used for all metadata records in this Exchange Catalogue</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="otherLocale" type="lan:PT_Locale_PropertyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Other languages and character sets used for the localized metadata records in this Exchange Catalogue</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="exchangeCatalogueDescription" type="gco:CharacterString_PropertyType"  minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Description of what the exchange catalogue contains</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="exchangeCatalogueComment" type="gco:CharacterString_PropertyType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Any additional Information</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="certificates" type="S100SE:S100_SE_CertificateContainerType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Signed public key certificates referred to by digital signatures in the Exchange Set</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dataServerIdentifier" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Identifies the data server for the permit</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="datasetDiscoveryMetadata">
				<xs:annotation>
					<xs:documentation>Container for S100_DatasetDiscoveryMetadata elements</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element ref="S100_DatasetDiscoveryMetadata" minOccurs="0" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Discovery metadata for single dataset. Constraints should be in a separate file for reusability and potential customization.</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="supportFileDiscoveryMetadata">
				<xs:annotation>
					<xs:documentation>Exchange Catalogues may include or reference discovery metadata for the support files in the Exchange Set</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element ref="S100_SupportFileDiscoveryMetadata" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="catalogueDiscoveryMetadata">
				<xs:annotation>
					<xs:documentation>Metadata for Catalogue</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element ref="S100_CatalogueDiscoveryMetadata" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="S100_CatalogueDiscoveryMetadata" type="S100_CatalogueDiscoveryMetadata">
		<xs:annotation>
			<xs:documentation>Substitution group head element</xs:documentation>
		</xs:annotation>
		<xs:key name="CTD_SIGNATURES_UNIQUE_ID">
			<xs:selector xpath=".//S100SE:S100_SE_DigitalSignature|.//S100SE:S100_SE_SignatureOnSignature|.//S100SE:S100_SE_SignatureOnData"></xs:selector>
			<xs:field xpath="@id"></xs:field>
		</xs:key>
		<xs:key name="CTD_UNIQUE_PRIMARY_SIGNATURE">
			<xs:selector xpath=".//S100SE:S100_SE_DigitalSignature"></xs:selector>
			<xs:field xpath="."></xs:field>
		</xs:key>
	</xs:element>
	<xs:complexType name="S100_CatalogueDiscoveryMetadata">
		<xs:annotation>
			<xs:documentation>Class for S-100 catalogue metadata.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="fileName" type="xs:anyURI" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The name for the catalogue</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="purpose" type="S100_Purpose" maxOccurs="1" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The purpose for which the Catalogue has been issued</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="editionNumber" type="xs:positiveInteger" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The Edition number of the Catalogue</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="scope" type="S100_CatalogueScope" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Subject domain of the catalogue.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="versionNumber" type="xs:string" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The version identifier of the Catalogue</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="issueDate" type="xs:date" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The issue date of the Catalogue</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="productSpecification" type="S100_ProductSpecification" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The product specification used to create this file.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="digitalSignatureReference" type="S100SE:S100_SE_DigitalSignatureReference_PropertyType" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Specifies the algorithm used to compute digitalSignatureValue</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="digitalSignatureValue" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Value derived from the digital signature. The value resulting from application of digitalSignatureReference. Implemented as the digital signature format specified in Part 15.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element ref="S100SE:S100_SE_DigitalSignature"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="compressionFlag" type="RestrictedBoolean" maxOccurs="1" minOccurs="1">
				<xs:annotation>
					<xs:documentation>Indicates if the resource is compressed</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="defaultLocale" type="lan:PT_Locale_PropertyType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Default language and character set used in the Catalogue</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="otherLocale" type="lan:PT_Locale_PropertyType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Other languages and character sets used in the Catalogue</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="S100_TemporalExtent">
		<xs:annotation>
			<xs:documentation>Temporal extent</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="timeInstantBegin" type="xs:dateTime" maxOccurs="1" minOccurs="0"><xs:annotation><xs:documentation>The instant at which the temporal extent begins</xs:documentation></xs:annotation></xs:element>
			<xs:element name="timeInstantEnd" type="xs:dateTime" maxOccurs="1" minOccurs="0"><xs:annotation><xs:documentation>The instant at which the temporal extent ends</xs:documentation></xs:annotation></xs:element>
		</xs:sequence>
	</xs:complexType>

	

